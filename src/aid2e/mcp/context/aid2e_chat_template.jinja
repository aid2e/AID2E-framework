      --chat-template /path/to/aid2e_chat_template.jinja \
      --reasoning-parser qwen3 \
      --enable-auto-tool-choice --tool-call-parser qwen3_coder

  Pass chat_mode per-request via `chat_template_kwargs`:
    "chat_template_kwargs": {"chat_mode": "Agent"}
