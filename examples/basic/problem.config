# Problem configuration for DTLZ2 toy problem
# This file specifies the optimization problem structure and objectives.

problem:
  name: "DTLZ2 Multi-Objective Optimization"
  problem_type: "toy"
  output_location: "./output/dtlz2"
  work_location: "./work/dtlz2"

  # Design parameters file (relative or absolute path)
  design_parameters_file: "./examples/basic/design.params"

  # Objectives specification
  objectives:
    - name: "f1"
      direction: "minimize"
    - name: "f2"
      direction: "minimize"
