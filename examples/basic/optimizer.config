# Optimizer configuration for DTLZ2 problem
# This example uses Bayesian Optimization (BO) with a Gaussian Process surrogate.

optimizer:
  kind: "BO"
  max_iterations: 100

  bo:
    surrogate_model:
      name: "GaussianProcess"
      kernel: "matern52"
      noise_level: 1.0e-6
      normalize_y: true

    acquisition_function:
      name: "EHVI"
      parameters:
        num_mc_samples: 128

    parameters:
      initial_design: "lhs"
      n_initial_samples: 20
      batch_size: 1
      parallel_evaluations: 1

# Alternative: Evolutionary Algorithm configuration (commented)
# optimizer:
#   kind: "EA"
#   max_iterations: 100
#
#   ea:
#     population_size: 100
#     crossover_rate: 0.9
#     mutation_rate: 0.1
