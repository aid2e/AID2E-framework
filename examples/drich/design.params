# ============================================================================
# dRICH Design Space Configuration
# ============================================================================

design_space:
  design_parameters:
    drich_geo:
      parameters:
        mirror_centerx:
          element: "centerx"
          value: 114.0
          bounds: [100.0, 160.0]
          xml_path: ".//detector/mirror/[@centerx]"
          unit: "cm"

        mirror_radius:
          element: "radius"
          value: 219.8
          bounds: [180.0, 260.0]
          xml_path: ".//detector/mirror/[@radius]"
          unit: "cm"

        sensor_centerx:
          element: "centerx"  
          value: 155.5
          bounds: [0.0, 0.25]
          xml_path: ".//detector/sensors/sphere/[@centerx]"
          unit: "cm"

        sensor_centerz:
          element: "centerz"
          value: 1.0
          bounds: [1.0, 3.0]
          xml_path: ".//detector/sensors/sphere/[@centerz]"
          unit: "cm"

        sensor_radius:
          element: "radius"
          value: 110.0
          bounds: [100.0, 500.0]
          xml_path: ".//detector/sensors/sphere/[@radius]"
          unit: "cm"

        snout_length:
          element: "value"
          value: 20.0
          bounds: [10.0, 25.0]
          xml_path: ".//constant[@name='DRICH_snout_length']"
          unit: "cm"
